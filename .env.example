# 환경 변수 예시
# 실제 값은 .env.local 또는 환경별 .env 파일에 정의한다.
#
# spec 출처: specs/phase0/004-dev-infrastructure/spec.md §2
#
# ── 실행 모드 (020에서 분리) ──
#   npm run dev        → MSW mock   (.env.local — 아래 조합 A)
#   npm run dev:real   → 실 백엔드  (.env.real  — 조합 B, commit 되어 있음)
#   npm run capture    → UI baseline 캡쳐 (.env.capture)
#
# 🔴 두 값은 **짝을 맞춰야** 한다. MSW 핸들러는 상대 경로(`/api/...`)라
#    페이지 origin 에만 매칭되므로, URL 에 외부 주소를 넣으면 MSW 를 켜도
#    요청이 그쪽으로 나가 가로채지 못한다.
#      A) mock      : VITE_API_BASE_URL=        + VITE_USE_MSW=true
#      B) 실 서버   : VITE_API_BASE_URL=http:// + VITE_USE_MSW=false
#    섞으면(URL 있음 + MSW true) 둘 다 아닌 상태가 된다.

# API base URL
# - 테스트 환경: 백엔드 서버 IP (예: http://10.10.0.10:8080)
# - 운영 환경: https://s-patrol.co.kr + 백엔드가 지정한 prefix
# - MSW 사용 시(VITE_USE_MSW=true)에는 빈 문자열이어도 됨(요청이 worker에서 가로채짐)
VITE_API_BASE_URL=

# MSW(Mock Service Worker) 사용 여부
# - 'true'일 때만 dev 환경에서 worker가 시작된다.
# - 백엔드가 준비되기 전 개발용. 실 백엔드 붙일 때 비워두거나 'false'로 설정.
VITE_USE_MSW=

# 환경 식별자 (표시 전용)
# - development / test / production
VITE_ENV=development

# ── 지도 타일 (spec 032) ──────────────────────────────────
# 🔴 **지도 코드는 공급자를 모른다** — URL 하나만 받으므로 공급자 교체에 코드를 고치지 않는다.
#
#   개발·테스트: OSM (키 불필요)
#     VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#     VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap
#
#   운영: V-World (인증키 필요)
#     VITE_MAP_TILE_URL=https://api.vworld.kr/req/wmts/1.0.0/{발급키}/Base/{z}/{y}/{x}.png
#     VITE_MAP_TILE_ATTRIBUTION=&copy; VWorld
#
# 🔴🔴 **운영 배포 전 반드시 V-World(또는 정식 공급자)로 바꾼다.**
#      OSM 공식 타일은 **개발·테스트 한정**이고 운영 트래픽은 사용 정책에 어긋난다.
# ⚠️ V-World 는 **인증키 + 사용 URL 등록**이 필요하다(Referer 검증) — localhost·테스트
#    서버·운영 도메인을 한 번에 신청해 둔다. **회사 명의로** 발급한다.
# ⚠️ 비워 두면 지도 대신 안내가 뜬다 — 나머지 화면은 멀쩡하다.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
