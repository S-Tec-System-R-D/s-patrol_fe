# 실 백엔드 연동 개발 환경 (`npm run dev:real`).
# 팀 공용 설정이라 commit 대상이다(.env.local 과 달리 .gitignore 에 걸리지 않는다).
#
# 왜 모드를 따로 두는가:
#   MSW 핸들러는 상대 경로(`/api/...`)로 등록돼 **페이지 origin 에만** 매칭된다.
#   `VITE_API_BASE_URL` 에 외부 주소가 들어가면 요청이 그쪽 origin 으로 나가 MSW 가
#   가로채지 못하고, `VITE_USE_MSW=true` 여도 사실상 실 서버로 흘러간다.
#   그 어정쩡한 상태를 없애려고 **mock 과 실 서버를 모드로 분리**했다.
#   (`npm run dev` = mock / `npm run dev:real` = 실 서버)
#
# Vite env 우선순위상 `.env.[mode]` 가 `.env.local` 보다 뒤에 로드되어 이긴다.
# 따라서 각자의 `.env.local` 내용과 무관하게 이 파일이 적용된다.
#
# 서버가 사내망에 있어 외부에서는 닿지 않을 수 있다. 응답이 없으면
# 로그인 시 "네트워크 연결을 확인해주세요" 가 뜬다(정상 동작 — 019 에러 정규화).

VITE_API_BASE_URL=http://123.2.156.148:5231
VITE_USE_MSW=false
VITE_ENV=development
