# 실 백엔드 연동 개발 환경 (`npm run dev:real`).
# 팀 공용 설정이라 commit 대상이다(.env.local 과 달리 .gitignore 에 걸리지 않는다).
#
# 🔴 **CORS 때문에 dev 프록시를 경유한다** (실측 2026-10-08, spec 022 Phase 8 R6)
#   백엔드가 `Access-Control-Allow-Origin` 을 **전혀 주지 않는다.** preflight 에는 204 를
#   주지만 CORS 헤더가 없어 브라우저가 응답을 버린다. 그래서 아래 `VITE_API_BASE_URL` 에
#   외부 주소를 직접 넣으면 **브라우저에서 전부 실패**한다.
#   (`curl` 은 CORS 를 적용하지 않아 API 계약 실측에서는 드러나지 않았다)
#
#   → 클라이언트는 **상대 경로**로 호출하고(`VITE_API_BASE_URL` 를 비운다),
#     `VITE_API_PROXY_TARGET` 을 vite dev 서버가 읽어 `/api` 를 백엔드로 중계한다.
#     브라우저 입장에서는 same-origin 이라 CORS 가 적용되지 않는다.
#
#   운영은 `CLAUDE.md` B4 대로 **도메인 + 백엔드 지정 prefix**(same-origin)이라 이 문제가
#   없다. 프록시는 로컬 개발 전용이다. 백엔드 CORS 설정 요청은 별개로 등재(B-18).
#
# 왜 모드를 따로 두는가:
#   `npm run dev` = mock(MSW) / `npm run dev:real` = 실 서버.
#   MSW 핸들러는 상대 경로(`/api/...`)로 등록돼 **페이지 origin 에만** 매칭된다.
#   이 파일은 `VITE_USE_MSW=false` 로 MSW 를 끄고 프록시를 달아, 같은 상대 경로가
#   MSW 대신 실 서버로 흐르게 한다. 🔴 **둘을 함께 켜지 말 것** — MSW 가 먼저 가로채
#   프록시가 무용지물이 되고, "실 서버에 붙은 줄 알았는데 mock" 인 상태가 된다.
#
# Vite env 우선순위상 `.env.[mode]` 가 `.env.local` 보다 뒤에 로드되어 이긴다.
# 따라서 각자의 `.env.local` 내용과 무관하게 이 파일이 적용된다.
#
# 서버가 사내망에 있어 외부에서는 닿지 않을 수 있다. 응답이 없으면
# 로그인 시 "네트워크 연결을 확인해주세요" 가 뜬다(정상 동작 — 019 에러 정규화).

# 🔴 비워 둔다 — 상대 경로로 호출해야 프록시를 탄다
VITE_API_BASE_URL=
# vite dev 서버만 읽는다(클라이언트 코드는 쓰지 않는다). `/api` → 이 주소로 중계
VITE_API_PROXY_TARGET=http://123.2.156.148:5231
VITE_USE_MSW=false
VITE_ENV=development
